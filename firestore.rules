rules_version = '2';

// ==========================================================================
// FIRESTORE.RULES
// Security Rules cho Cloud Firestore của website SPORTHUB.
//
// Nguyên tắc:
//   - Không có "allow read, write: if true" cho dữ liệu riêng tư.
//   - Dữ liệu công khai (Products, Categories, Reviews, Settings) chỉ cho ĐỌC.
//   - Mỗi user chỉ đọc/ghi document của chính mình (Users, Carts, Orders).
//   - User KHÔNG tự sửa được role/disabled -> không thể tự nâng quyền admin.
//   - Chỉ admin (Users/{uid}.role == "admin") mới quản trị dữ liệu cửa hàng.
//
// Triển khai: firebase deploy --only firestore:rules
// ==========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------- Helper ----------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/Users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/Users/$(request.auth.uid))
        && userDoc().role == 'admin';
    }

    // Các field mà user thường không được tự thay đổi.
    function keepsProtectedFields() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.get('disabled', false) == resource.data.get('disabled', false);
    }

    // ---------------------- Users ----------------------
    match /Users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // Tạo profile của chính mình, bắt buộc role = "user".
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.get('disabled', false) == false;

      // Chủ sở hữu sửa thông tin cá nhân nhưng không sửa role/disabled.
      allow update: if (isOwner(uid) && keepsProtectedFields()) || isAdmin();

      // Không cho xoá tài khoản từ client (dữ liệu đơn hàng cần được giữ).
      allow delete: if false;
    }

    // ---------------------- Products ----------------------
    match /Products/{productId} {
      allow read: if true;                 // storefront cần đọc khi chưa đăng nhập
      allow create, update, delete: if isAdmin();
    }

    // ---------------------- Categories ----------------------
    match /Categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------------------- Carts ----------------------
    // Mỗi user một document giỏ hàng: Carts/{uid}
    match /Carts/{uid} {
      allow read, create, update, delete: if isOwner(uid);
    }

    // ---------------------- Orders ----------------------
    match /Orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      // User chỉ tạo đơn cho chính mình và luôn bắt đầu ở trạng thái "pending".
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.total is number
        && request.resource.data.total >= 0;

      // Admin cập nhật mọi trạng thái; chủ đơn chỉ được tự huỷ đơn còn "pending".
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.uid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.total == resource.data.total);

      allow delete: if isAdmin();
    }

    // ---------------------- Reviews ----------------------
    match /Reviews/{reviewId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 1000;

      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;

      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------------------- Settings ----------------------
    match /Settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------- Mặc định: chặn ----------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
